/*
Problem Name: Grid Coloring I
Problem Link: https://cses.fi/problemset/task/3311
*/
#include<bits/stdc++.h>
using namespace std;
#define MOD 1000000007
#define ll long long int  
#define loop(a,b) for(int i=a;i<b;i++)
 
char fill(vector<string>&ar, char curr, char up, char left){
    if(curr!='A'&&left!='A'&&up!='A')
        return 'A';
    if(curr!='B'&&left!='B'&&up!='B')
        return 'B';
    if(curr!='C'&&left!='C'&&up!='C')
        return 'C';
    if(curr!='D'&&left!='D'&&up!='D')
        return 'D';
}
bool solve(vector<string>&ar, int n, int m, int x, int y){
    if(x>=n)
        return true;
    if(y>=m)
        return solve(ar,n,m,x+1,0);
    if(x-1>=0&&y>=0){
        ar[x][y]=fill(ar,ar[x][y],ar[x-1][y],ar[x][y-1]);
    }
    else if(x-1>=0){
        ar[x][y]=fill(ar,ar[x][y],ar[x-1][y],'\0');
    }
    else if(y-1>=0){
        ar[x][y]=fill(ar,ar[x][y],'\0',ar[x][y-1]);
    }
    else
        ar[x][y]=fill(ar,ar[x][y],'\0','\0');
    solve(ar,n,m,x,y+1);
    return false;
}
void solution() {
    int n,m;
    cin>>n>>m;
    vector<string>ar(n);
    for(int i=0;i<n;i++)
        cin>>ar[i];
    solve(ar,n,m,0,0);
    for(auto &x: ar)
        cout<<x<<endl;
}
 
 
 
int main() {
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);
    ll t=1;
    //cin>>t;
    while(t--){
        solution();
    }
    return 0;
}
